{
    "name": "bonyan-api",
    "version": "2.1.0",
    "description": "API for broadcasting the Quran and Islamic supplications, with automatic fallback between multiple sources and a unified data interface (Quran, Tafsir, Azkar, Hadith, Prayer Times, Hijri Date, Qibla)",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint src tests scripts --fix",
        "lint:check": "eslint src tests scripts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check:upstreams": "tsx scripts/check-upstreams.ts",
        "cloudflare:check": "pnpm exec wrangler deploy --dry-run --containers-rollout=none --config wrangler.toml",
        "cloudflare:startup": "tsx scripts/check-worker-startup.ts",
        "deploy:cloudflare": "pnpm exec wrangler deploy --config wrangler.toml",
        "prepare": "husky"
    },
    "keywords": [
        "quran",
        "azkar",
        "tafsir",
        "hadith",
        "prayer-times",
        "hijri",
        "qibla",
        "islamic-api",
        "radio",
        "api",
        "typescript",
        "fastify"
    ],
    "author": "BonyanOSS",
    "license": "MIT",
    "packageManager": "pnpm@10.33.4",
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/rate-limit": "^11.0.0",
        "adhan": "^4.4.6",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261004.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.1",
        "@vitest/coverage-v8": "^4.1.9",
        "ajv": "^8.20.0",
        "eslint": "^10.6.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-simple-header": "^1.2.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.9",
        "wrangler": "^4.147.0",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": ">=24 <25"
    }
}
